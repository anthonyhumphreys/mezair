      "html": "<button type=\"button\" class=\"ds-button ds-primary\">Download for Mac</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;white-space:nowrap;border-radius:calc(var(--radius,0.625rem) - 2px);font-family:var(--font-sans),ui-sans-serif,system-ui,sans-serif;font-size:0.875rem;font-weight:500;line-height:1.25rem;height:2.5rem;padding:0.5rem 1rem;transition:background-color 150ms,border-color 150ms,color 150ms,transform 150ms;cursor:pointer}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid oklch(var(--ring));outline-offset:2px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{border:0;background:oklch(var(--primary));color:oklch(var(--primary-foreground));font-weight:600;box-shadow:inset 0 -1px 0 oklch(0 0 0/.18),0 1px 2px oklch(.2 .02 255/.12)}.ds-primary:hover{background:color-mix(in oklch,oklch(var(--primary)) 88%,white)}"

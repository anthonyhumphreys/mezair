      "css": ".ds-cine{--background:0.135 0.03 266;--foreground:0.965 0.006 250;--card:0.175 0.03 264;--card-foreground:0.965 0.006 250;--popover:0.19 0.032 264;--popover-foreground:0.965 0.006 250;--primary:0.76 0.17 54;--primary-foreground:0.16 0.03 266;--secondary:0.21 0.03 264;--secondary-foreground:0.965 0.006 250;--muted:0.2 0.03 264;--muted-foreground:0.77 0.02 255;--accent:0.76 0.17 54;--accent-foreground:0.16 0.03 266;--border:0.3 0.03 262;--input:0.34 0.032 262;--ring:0.78 0.16 56;--artifact-bg:0.168 0.033 266;--artifact-raised:0.212 0.035 263;--artifact-line:0.35 0.036 262;--artifact-faint:0.46 0.035 260;--artifact-text:0.96 0.008 255;--artifact-dim:0.76 0.024 255;--artifact-accent:0.77 0.17 53;--artifact-ok:0.8 0.15 158;--cine-ease:cubic-bezier(0.16, 1, 0.3, 1);font-family:var(--font-sans),ui-sans-serif,system-ui,sans-serif;color:oklch(var(--foreground));background:oklch(var(--background));padding:1rem}.ds-reel-tab{position:relative;display:grid;min-height:2.9rem;align-content:start;gap:.1rem;border:0;border-top:1px solid oklch(var(--border));padding:.65rem .25rem .35rem 0;background:transparent;color:oklch(var(--muted-foreground));font-family:inherit;text-align:left;transition:color 300ms}.ds-reel-tab:hover,.ds-reel-tab[aria-selected=\"true\"]{color:oklch(var(--foreground))}.ds-reel-tab:focus-visible{outline:2px solid oklch(var(--ring));outline-offset:3px;border-radius:4px}.ds-reel-label{font-size:.9375rem;font-weight:600;line-height:1.3}.ds-reel-hint{display:none;font-size:.8125rem;line-height:1.4;color:oklch(var(--muted-foreground))}.ds-reel-progress{position:absolute;top:-1px;left:0;right:0;height:2px;background:oklch(var(--accent));transform:scaleX(.5);transform-origin:left center;transition:transform 140ms linear}@media(min-width:768px){.ds-reel-hint{display:block}}"
    }
  ],
  "narrative": {
    "northStar": "The projection room and the workbench",
    "overview": "Mezair shares one identity across two visual worlds: a calm, inspectable reading workspace and a dramatic projection room where real captures of the working product carry the marketing. Both use cool neutrals, Archivo, the monochrome horse-M and a restrained orange action accent. The mark follows the text color.\n\nThe always-dark projection room covers `/`, `/sync`, `/pricing` and `/what-does-mezair-mean`. The naming page is its quieter identity expression: power under precise control, with strength, discipline, progression and elegance expressed through the large horse-M and a visitor-triggered hop. Docs, account, workspace, auth and shared-artifact routes retain their existing reading and operating styles; the cinematic scope does not replace them.",
    "keyCharacteristics": [
      "Cool neutral grounds, a single action accent and explicit status words.",
      "Wide, heavy display type paired with normal-width interface text.",
      "Real Desktop captures with fixture data, labelled motion diagrams, divided comparisons and quiet reading surfaces.",
      "Purposeful motion with pause controls, reduced-motion support and static initial frames."
    ],
    "rules": [
      {
        "name": "The Scope Rule",
        "body": "Keep the cinematic palette inside the marketing wrapper. Reading and operating routes retain their established theme bindings.",
        "section": "colors"
      },
      {
        "name": "The Display Rule",
        "body": "Use wide Archivo for headings and large prices; keep body and interface text at normal width.",
        "section": "typography"
      },
      {
        "name": "The Lit Object Rule",
        "body": "Reserve cinematic depth for product windows and staged objects. Keep comparisons and explanatory lists divided and quiet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the horse-M monochrome and bound to the surrounding text color.",
      "Do use the scoped marketing palette on all four cinematic routes and keep their theme toggle hidden.",
      "Do use real captures with fixture data for every product image, with alt text that describes the screen, and label motion diagrams as fixture content.",
      "Do pair operational colors with text.",
      "Do keep chapter selection, pause controls, keyboard focus and reduced-motion behavior available.",
      "Do preserve the naming page’s click-triggered horseplay and its power-under-control character."
    ],
    "donts": [
      "Don't carry cinematic page styling into docs, account or workspace routes.",
      "Don't use gradient text, decorative glass, drawn or composited product UI, fake metrics or testimonials.",
      "Don't replace divided comparisons with a repetitive grid of equal icon cards.",
      "Don't add decorative eyebrows, kickers or machine-looking labels to marketing headings.",
      "Don't turn the orange accent into a large decorative background or convey status through color alone."
    ]
  }
}
